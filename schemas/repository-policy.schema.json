{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "1"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "rules": {
      "minItems": 1,
      "maxItems": 1000,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{0,99}$"
          },
          "setting": {
            "type": "string",
            "enum": [
              "visibility",
              "archived",
              "default_branch",
              "allow_merge_commit",
              "allow_squash_merge",
              "allow_rebase_merge",
              "delete_branch_on_merge"
            ]
          },
          "expected": {
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "type": "string",
                "maxLength": 200
              }
            ]
          },
          "repositories": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-zA-Z0-9._-]+\\/[a-zA-Z0-9._-]+$"
            }
          }
        },
        "required": [
          "id",
          "setting",
          "expected"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schemaVersion",
    "name",
    "rules"
  ],
  "additionalProperties": false
}
