{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "months": {
      "minItems": 1,
      "maxItems": 6,
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^\\d{4}-(0[1-9]|1[0-2])$"
      }
    },
    "inventory": {
      "default": true,
      "type": "boolean"
    }
  },
  "required": [
    "inventory"
  ],
  "additionalProperties": false
}
