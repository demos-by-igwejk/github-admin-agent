{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "rows": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]{0,99}\\/[a-zA-Z0-9._-]{1,100}$"
          },
          "repository": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]{0,99}\\/[a-zA-Z0-9._-]{1,100}$"
          },
          "classification": {
            "type": "string",
            "enum": [
              "active",
              "inactive",
              "unknown"
            ]
          },
          "policy": {
            "type": "object",
            "properties": {
              "name": {
                "default": "recent-activity",
                "type": "string",
                "minLength": 1,
                "maxLength": 200
              },
              "window": {
                "default": {
                  "kind": "calendar-months",
                  "value": 6
                },
                "oneOf": [
                  {
                    "type": "object",
                    "properties": {
                      "kind": {
                        "type": "string",
                        "const": "days"
                      },
                      "value": {
                        "type": "integer",
                        "minimum": 1,
                        "maximum": 3660
                      }
                    },
                    "required": [
                      "kind",
                      "value"
                    ],
                    "additionalProperties": false
                  },
                  {
                    "type": "object",
                    "properties": {
                      "kind": {
                        "type": "string",
                        "const": "calendar-months"
                      },
                      "value": {
                        "type": "integer",
                        "minimum": 1,
                        "maximum": 120
                      }
                    },
                    "required": [
                      "kind",
                      "value"
                    ],
                    "additionalProperties": false
                  }
                ]
              },
              "signals": {
                "default": [
                  "push"
                ],
                "minItems": 1,
                "maxItems": 6,
                "type": "array",
                "items": {
                  "type": "string",
                  "enum": [
                    "push",
                    "commits",
                    "issues",
                    "pull_requests",
                    "discussions",
                    "actions"
                  ]
                }
              },
              "positiveShortCircuit": {
                "default": true,
                "type": "boolean"
              },
              "clockSkewSeconds": {
                "default": 60,
                "type": "integer",
                "minimum": 0,
                "maximum": 300
              }
            },
            "required": [
              "name",
              "window",
              "signals",
              "positiveShortCircuit",
              "clockSkewSeconds"
            ],
            "additionalProperties": false
          },
          "cutoff": {
            "type": "string"
          },
          "signals": {
            "minItems": 6,
            "maxItems": 6,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string",
                  "enum": [
                    "push",
                    "commits",
                    "issues",
                    "pull_requests",
                    "discussions",
                    "actions"
                  ]
                },
                "state": {
                  "type": "string",
                  "enum": [
                    "positive",
                    "negative",
                    "unknown",
                    "disabled",
                    "not_applicable",
                    "skipped"
                  ]
                },
                "observedAt": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "latestAt": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "evidenceIds": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "reason": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": [
                "name",
                "state",
                "observedAt",
                "latestAt",
                "evidenceIds",
                "reason"
              ],
              "additionalProperties": false
            }
          },
          "reason": {
            "type": "string",
            "minLength": 1
          },
          "evidenceIds": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "required": [
          "id",
          "repository",
          "classification",
          "policy",
          "cutoff",
          "signals",
          "reason",
          "evidenceIds"
        ],
        "additionalProperties": false
      }
    },
    "totals": {
      "type": "object",
      "properties": {
        "active": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "inactive": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "unknown": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "observed": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "assessed": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "active",
        "inactive",
        "unknown",
        "observed",
        "assessed"
      ],
      "additionalProperties": false
    },
    "work": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "required": {
            "type": "boolean"
          },
          "outcome": {
            "type": "string",
            "enum": [
              "valid",
              "failed",
              "unassessed",
              "policy-excluded",
              "waiting",
              "cancelled"
            ]
          },
          "reasonCode": {
            "type": "string"
          },
          "evidenceIds": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "id",
          "required",
          "outcome",
          "evidenceIds"
        ],
        "additionalProperties": false
      }
    },
    "coverage": {
      "type": "object",
      "properties": {
        "discovery": {
          "type": "string",
          "enum": [
            "api-visible",
            "declared-targets",
            "not-applicable"
          ]
        },
        "requested": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            {
              "type": "null"
            }
          ]
        },
        "observed": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "assessed": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "pagination": {
          "type": "string",
          "enum": [
            "complete",
            "partial",
            "not-applicable"
          ]
        },
        "unassessed": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "excluded": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "notes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "discovery",
        "requested",
        "observed",
        "assessed",
        "pagination",
        "unassessed",
        "excluded",
        "notes"
      ],
      "additionalProperties": false
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "required": [
    "rows",
    "totals",
    "work",
    "coverage",
    "limitations"
  ],
  "additionalProperties": false
}
